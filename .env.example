# Gmail Order Processor Configuration
# Copy this file to .env and fill in your actual values

# =================================================================
# REQUIRED: inFlow API Configuration
# =================================================================
# Your inFlow API key (get from inFlow settings)
INFLOW_API_KEY=your-inflow-api-key-here

# Your inFlow company ID (get from inFlow settings)
INFLOW_COMPANY_ID=your-company-id-here

# =================================================================
# OPTIONAL: Application Settings
# =================================================================
# How often to check Gmail for new emails (seconds)
POLL_INTERVAL=60

# Auto-shutdown after X hours of no email processing activity
# Set to 0 to disable auto-shutdown
AUTO_SHUTDOWN_HOURS=2.0

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Storage directory for local data files
STORAGE_DIR=local_data

# =================================================================
# GMAIL AUTHENTICATION
# =================================================================
# Gmail authentication is handled via OAuth 2.0
# No email credentials needed in this file!
# 
# Run 'python setup_oauth_flow.py' to set up Gmail authentication
# This will create 'credentials.json' and 'token.json' files
#
# EMAILS: The system only processes matching emails received after the app starts