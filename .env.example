# Local Gmail Order Processor Configuration
# Copy this file to .env.local and fill in your actual values

# =================================================================
# REQUIRED: Gmail Authentication
# =================================================================
# Your Gmail email address
GMAIL_USERNAME=your-email@gmail.com

# Your Gmail App Password (NOT your regular Gmail password)
# To create an App Password:
# 1. Go to https://myaccount.google.com/
# 2. Navigate to Security > 2-Step Verification
# 3. Scroll down to "App passwords"
# 4. Generate a password for "Mail" application
# 5. Use that 16-character password here
GMAIL_PASSWORD=your-16-character-app-password

# =================================================================
# REQUIRED: inFlow API Configuration
# =================================================================
# Your inFlow API key - get this from inFlow settings
INFLOW_API_KEY=your-inflow-api-key

# Your inFlow company ID - get this from inFlow settings
INFLOW_COMPANY_ID=your-inflow-company-id

# =================================================================
# OPTIONAL: Polling Configuration
# =================================================================
# How often to check Gmail for new emails (in seconds)
# Default: 60 (check every minute)
POLL_INTERVAL=60

# How many days back to search for emails
# Default: 7 (search last 7 days)
SEARCH_DAYS=7

# Auto-shutdown after hours of no email processing activity
# Default: 2.0 (shutdown after 2 hours of no new emails processed)
# Set to 0 to disable auto-shutdown
AUTO_SHUTDOWN_HOURS=2.0

# =================================================================
# OPTIONAL: Logging and Storage
# =================================================================
# Logging level (DEBUG, INFO, WARNING, ERROR)
# Default: INFO
LOG_LEVEL=INFO

# Directory to store local data (processed emails tracking)
# Default: local_data
STORAGE_DIR=local_data

# =================================================================
# ADVANCED: inFlow API Configuration (Usually not needed)
# =================================================================
# Only change these if you're using a different inFlow environment
# INFLOW_BASE_URL=https://cloudapi.inflowinventory.com